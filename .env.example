# ---------------------------------------------------------------------------
# LegacyLens configuration. Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# With USE_MOCKS=true everything below can stay blank — the app runs fully
# offline on deterministic mock LLM + in-memory search.
# ---------------------------------------------------------------------------
USE_MOCKS=true

# --- Azure OpenAI via Azure AI Foundry -------------------------------------
# Endpoint looks like https://<resource>.openai.azure.com/ (or the Foundry
# project endpoint). Deployment names are YOUR deployment names, not model ids.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search -------------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=legacylens-chunks

# Must match the embedding deployment (3-small=1536, 3-large=3072)
EMBEDDING_DIM=1536

# --- LLM behaviour ---------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# --- API -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Teams bot (Azure Bot Service + single-tenant Entra app) ---------------
# From the Azure Bot resource -> Configuration. Secret: Manage -> Certificates & secrets.
BOT_APP_ID=
BOT_APP_PASSWORD=
BOT_APP_TENANT_ID=
BOT_APP_TYPE=SingleTenant
# Public HTTPS URL (dev tunnel / App Service); bot endpoint = <url>/api/messages
PUBLIC_BASE_URL=

# --- Live data storage + PII (keyless: Entra ID via az login / managed identity) ---
AZURE_STORAGE_ACCOUNT_URL=https://legacylensdata.blob.core.windows.net
AZURE_TABLES_ACCOUNT_URL=https://legacylensdata.table.core.windows.net
AZURE_STORAGE_CONTAINER=knowledge
AZURE_LANGUAGE_ENDPOINT=https://legacylens-language.cognitiveservices.azure.com/

# --- Live Microsoft 365: consent, project-chat detection, capture ---------------
# Independent of USE_MOCKS. true = real Graph + Azure Tables; false = in-memory mocks.
LIVE_M365=false
# Random string Graph echoes on every notification (python -c "import secrets;print(secrets.token_urlsafe(24))")
GRAPH_WEBHOOK_CLIENT_STATE=
# Optional: org-catalog id of the LegacyLens app (else looked up with AppCatalog.Read.All)
TEAMS_CATALOG_APP_ID=
# Optional: Graph app if different from the bot's Entra app
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Audit trail (admin page) ------------------------------------------------
# Append blobs in AZURE_STORAGE_ACCOUNT_URL/<AUDIT_CONTAINER>/events/YYYY/MM/DD/HH.jsonl
AUDIT_CONTAINER=audit
# Required as the X-Admin-Key header on GET /audit (python -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_API_KEY=

# --- Dashboard (org -> account -> project over the audit trail) -----------------
ORG_NAME=Organisation
DEFAULT_ACCOUNT_NAME=Default account
# Project (Teams team name or team id) -> client account, as JSON. Blank = everything under the default account.
# PROJECT_ACCOUNTS={"Payments Platform": "Contoso Payments", "Storefront Revamp": "Northwind Retail"}
PROJECT_ACCOUNTS=
# Offline only (LIVE_M365=false): fill the dashboard with three weeks of generated demo activity.
DASHBOARD_DEMO=false

# --- Knowledge sources --------------------------------------------------------
# false = never load data/sample; knowledge comes only from SharePoint + consented Teams chats.
USE_SAMPLE_DATA=true
# Project site whose document libraries are loaded (delta sync every SHAREPOINT_SYNC_MINUTES)
SHAREPOINT_SITE_URL=
SHAREPOINT_SYNC_MINUTES=5
