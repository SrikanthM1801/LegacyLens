# ---------------------------------------------------------------------------
# LegacyLens configuration. Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# With USE_MOCKS=true everything below can stay blank — the app runs fully
# offline on deterministic mock LLM + in-memory search.
# ---------------------------------------------------------------------------
USE_MOCKS=true

# --- Azure OpenAI via Azure AI Foundry -------------------------------------
# Endpoint looks like https://<resource>.openai.azure.com/ (or the Foundry
# project endpoint). Deployment names are YOUR deployment names, not model ids.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search -------------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=legacylens-chunks

# Must match the embedding deployment (3-small=1536, 3-large=3072)
EMBEDDING_DIM=1536

# --- LLM behaviour ---------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# --- API -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
